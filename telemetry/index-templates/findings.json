{
  "index_patterns": [
    "findings-*"
  ],
  "priority": 200,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0
    },
    "mappings": {
      "dynamic": "true",
      "dynamic_templates": [
        {
          "strings": {
            "match_mapping_type": "string",
            "mapping": {
              "type": "keyword",
              "ignore_above": 1024
            }
          }
        }
      ],
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "pipeline_id": {
          "type": "long"
        },
        "pipeline_url": {
          "type": "keyword"
        },
        "commit": {
          "type": "keyword"
        },
        "ref": {
          "type": "keyword"
        },
        "project": {
          "type": "keyword"
        },
        "tool": {
          "type": "keyword"
        },
        "scan": {
          "type": "keyword"
        },
        "job": {
          "type": "keyword"
        },
        "rule_id": {
          "type": "keyword"
        },
        "title": {
          "type": "text",
          "fields": {
            "raw": {
              "type": "keyword",
              "ignore_above": 512
            }
          }
        },
        "severity": {
          "type": "keyword"
        },
        "severity_rank": {
          "type": "byte"
        },
        "fingerprint": {
          "type": "keyword"
        },
        "location": {
          "type": "keyword"
        },
        "package": {
          "type": "keyword"
        },
        "installed_version": {
          "type": "keyword"
        },
        "fixed_version": {
          "type": "keyword"
        },
        "fix_available": {
          "type": "boolean"
        },
        "cve": {
          "type": "keyword"
        },
        "instances": {
          "type": "integer"
        },
        "description": {
          "type": "text"
        }
      }
    }
  }
}
